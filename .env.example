# Copy to .env.production.local (or set in your hosting dashboard) for the PRODUCTION deployment only.
# Leave both unset on previews: the site then emits noindex, a disallow-all robots.txt, no canonical
# URLs, an empty sitemap and no absolute social/JSON-LD URLs.

# Absolute https origin of the live site, used for canonicals, sitemap, Open Graph and JSON-LD.
SITE_URL=https://212chicken.ma

# "true" only on the production deployment, to allow indexing.
SITE_INDEXABLE=true
